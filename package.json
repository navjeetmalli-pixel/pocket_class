{
  "name": "pocket-class",
  "version": "1.0.0",
  "private": true,
  "description": "Pocket Class India: offline study app for Classes 1–12 (CBSE / NCERT and PSEB).",
  "scripts": {
    "validate": "node scripts/validate.js",
    "build:index": "node scripts/build-index.js",
    "build:www": "node scripts/build-www.js",
    "sync": "npm run build:www && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "test": "playwright test -c tests",
    "test:headed": "playwright test -c tests --headed",
    "test:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1"
  }
}
